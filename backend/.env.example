PORT=3000
JWT_SECRET=troque-por-uma-chave-aleatoria-longa
# SQLite é o padrão; DATABASE_URL sozinha não muda o banco.
DB_CLIENT=sqlite
# Para o PostgreSQL/Supabase, aplique supabase/migrations antes e defina:
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# TLS exige verificação do certificado. CA personalizada é opcional.
# PG_SSL=require
# PG_SSL_CA_FILE=C:/caminho/certificado-ca.pem
# Somente desenvolvimento/teste com host loopback: PG_SSL=disable
